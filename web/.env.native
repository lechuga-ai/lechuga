# Loaded by `vite build --mode native` (npm run build:native): the build that
# goes inside the iOS and Android apps. Not secrets; committed on purpose.
#
# Where the app's API is. Inside the app the pages come from the phone, so
# every /api call needs an absolute address. Point it at prod for a release.
VITE_API_BASE=https://dev.lechuga.ai
# Tells the web app it's running inside the native app.
VITE_NATIVE=1
